@model IEnumerable<ThuongMaiDienTu_DoAn.Models.LOAISANPHAM>
@{
    ViewBag.Title = "Dashboard quản trị";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4 mt-4">
    <h2 class="fw-bold text-primary mb-3">Quản lý loại sản phẩm</h2>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="fw-bold text-dark mb-3">Danh sách loại sản phẩm</h5>
            <form action="/Admin/ThemLoaiSanPham" method="post" class="mb-4 d-flex align-items-center">
                <input type="text" name="TenLoai" class="form-control w-25 me-2" placeholder="Tên loại sản phẩm mới" required />
                <button type="submit" class="btn btn-success">Thêm</button>
            </form>

            <table class="table table-bordered text-center align-middle">
                <thead class="table-info">
                    <tr>
                        <th>Mã loại</th>
                        <th>Tên loại</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MaLoai</td>
                                <td>@item.TenLoai</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="2" class="text-muted">Chưa có loại sản phẩm nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
