@model ThuongMaiDienTu_DoAn.Models.SANPHAM

@{
    ViewBag.Title = "Chỉnh sửa sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy danh sách ảnh cũ để hiển thị preview
    var anhBiaCu = Model.HINHANHSPs.FirstOrDefault(a => a.AnhBia == true)?.URLAnh;
    var anhChiTietCu = Model.HINHANHSPs.Where(a => a.AnhBia == false).ToList();
}

<div class="container py-4">
    <h3 class="fw-bold mb-4 text-primary">📝 Chỉnh sửa sản phẩm: @Model.TenSP</h3>

    @using (Html.BeginForm("Sua", "SanPham", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.MaSP) @* Gửi ID sản phẩm đi kèm để biết sản phẩm nào cần sửa *@
        @Html.HiddenFor(m => m.MaKH) @* Giữ MaKH cũ *@
        @Html.HiddenFor(m => m.NgayTao) @* Giữ Ngày Tạo cũ *@
        @Html.Hidden("id", Model.MaSP) @* Dùng cho Action Sua(..., int? id) *@

        <div class="row bg-white shadow rounded p-4">

            <!-- CỘT TRÁI -->
            <div class="col-md-6">

                <label class="form-label fw-semibold">Tên sản phẩm</label>
                @Html.TextBoxFor(m => m.TenSP,
                    new { @class = "form-control mb-3", placeholder = "Nhập tên sản phẩm...", required = "required" })

                <label class="form-label fw-semibold">Danh mục</label>
                @Html.DropDownList("MaLoai", null,
                    "Chọn danh mục", // Giá trị này sẽ bị SelectList ở Controller ghi đè
                    new { @class = "form-select mb-3", required = "required" })

                <label class="form-label fw-semibold">Giá bán (VNĐ)</label>
                @* Dùng @Model.Gia để điền giá trị cũ *@
                <input name="Gia"
                       class="form-control mb-3 no-spin"
                       type="number" min="0"
                       placeholder="Ví dụ: 1500000" required
                       value="@Model.Gia" />

                <label class="form-label fw-semibold">Số lượng</label>
                @* Dùng @Model.SoLuong để điền giá trị cũ *@
                <input name="SoLuong"
                       class="form-control mb-3 no-spin"
                       type="number" min="1"
                       placeholder="Nhập số lượng" required
                       value="@Model.SoLuong" />

                <!-- ẢNH BÌA -->
                <label class="form-label fw-semibold mt-2">Ảnh bìa sản phẩm (Chọn file mới nếu muốn thay đổi)</label>
                <input type="file" name="files" class="form-control mb-2" accept="image/*" onchange="previewCover(this)" />
                <small class="text-muted mb-2 d-block">Ảnh bìa hiện tại:</small>

                <!-- Hiển thị ảnh bìa cũ hoặc ảnh mới sau khi chọn -->
                @if (!string.IsNullOrEmpty(anhBiaCu))
                {
                    <img id="previewCoverImg"
                         src="~/Content/Images/@anhBiaCu"
                         class="mt-2 rounded"
                         style="width:160px;height:auto;border:1px solid #eee;" />
                }
                else
                {
                    <img id="previewCoverImg" class="mt-2 rounded d-none" style="width:160px;height:auto;border:1px solid #eee;" />
                }
            </div>

            <!-- CỘT PHẢI -->
            <div class="col-md-6">

                <label class="form-label fw-semibold">Mô tả chi tiết</label>
                @* Dùng Html.TextAreaFor để điền Mô tả cũ *@
                @Html.TextAreaFor(m => m.MoTa, 6, 50, new { @class = "form-control mb-3", placeholder = "Mô tả tình trạng sản phẩm, phụ kiện đi kèm...", required = "required" })

                <!-- ẢNH CHI TIẾT -->
                <label class="form-label fw-semibold">Ảnh chi tiết sản phẩm (Chọn file mới để THAY THẾ toàn bộ ảnh chi tiết cũ)</label>
                <input type="file" name="files" class="form-control" multiple accept="image/*" onchange="previewImages(this)" />

                <small class="text-muted">Chọn file mới để thay thế toàn bộ ảnh chi tiết cũ. (Nếu không chọn, ảnh cũ sẽ giữ nguyên).</small>

                <div id="previewList" class="mt-3 d-flex flex-wrap gap-2">
                    <!-- Hiển thị ảnh chi tiết cũ -->
                    @foreach (var anh in anhChiTietCu)
                    {
                        <img src="~/Content/Images/@anh.URLAnh"
                             class="rounded border"
                             style="width:100px;height:100px;object-fit:cover;" />
                    }
                </div>
            </div>

            <div class="col-12 mt-4">
                <button class="btn btn-warning px-4 py-2 fw-semibold">
                    <i class="bi bi-upload"></i> Cập nhật tin bán
                </button>
                <a href="@Url.Action("ChiTiet", new { id = Model.MaSP })" class="btn btn-outline-secondary px-4 py-2 fw-semibold ms-2">
                    Hủy bỏ
                </a>
            </div>
        </div>
    }
</div>

<style>
    .no-spin::-webkit-inner-spin-button,
    .no-spin::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>

<script>
    // Preview ảnh bìa
    function previewCover(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.getElementById("previewCoverImg");
                img.src = e.target.result;
                img.classList.remove("d-none");
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Preview nhiều ảnh chi tiết
    function previewImages(input) {
        const preview = document.getElementById("previewList");
        preview.innerHTML = ""; // Xóa ảnh cũ khi chọn ảnh mới

        [...input.files].forEach(file => {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.createElement("img");
                img.src = e.target.result;
                img.classList = "rounded border";
                img.style = "width:100px;height:100px;object-fit:cover;";
                preview.appendChild(img);
            }
            reader.readAsDataURL(file);
        });
    }
</script>