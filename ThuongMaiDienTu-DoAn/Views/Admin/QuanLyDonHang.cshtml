
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}



@model IEnumerable<ThuongMaiDienTu_DoAn.Models.DonHangC2CViewModel>

<h4 class="fw-bold text-primary mb-3">Quản lý đơn hàng</h4>

<table class="table table-bordered text-center">
    <thead class="table-info">
        <tr>
            <th>Mã HD</th>
            <th>Người mua</th>
            <th>Người bán</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaHD</td>
                    <td>@item.NguoiMua</td>
                    <td>@item.NguoiBan</td>
                    <td>
                        @(item.NgayDat.HasValue
                            ? item.NgayDat.Value.ToString("dd/MM/yyyy")
                            : "")
                    </td>
                    <td class="text-danger fw-bold">
                        @String.Format("{0:N0} ₫", item.TongTien)
                    </td>
                    <td>@item.TrangThai</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-muted">
                    Không có đơn hàng nào.
                </td>
            </tr>
        }
    </tbody>
</table>
