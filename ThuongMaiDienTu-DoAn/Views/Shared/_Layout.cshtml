@using ThuongMaiDienTu_DoAn.Models
@{
    var user = Session["user"] as ThuongMaiDienTu_DoAn.Models.NGUOIDUNG;
    var anh = user != null && !string.IsNullOrEmpty(user.AnhDaiDien)
        ? Url.Content("~/Content/Avatars/" + user.AnhDaiDien)
        : Url.Content("~/Content/Avatars/Default.jpg");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - TechSecond</title>
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            background: linear-gradient(90deg, #212529, #343a40);
        }

        .navbar-brand {
            color: #ffc107 !important;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .nav-link {
            color: #ddd !important;
            font-weight: 500;
            transition: .2s;
        }

            .nav-link:hover, .nav-link.active {
                color: #ffc107 !important;
            }

        footer {
            background: #212529;
            color: #bbb;
            padding: 25px 0;
            text-align: center;
            margin-top: 50px;
        }

            footer a {
                color: #ffc107;
                text-decoration: none;
            }

                footer a:hover {
                    text-decoration: underline;
                }
        /* 1. Dùng Flexbox để căn giữa icon và chữ theo chiều dọc */
        .dropdown-item {
            display: flex !important;
            align-items: center !important;
            padding: 10px 20px; /* Tăng khoảng cách chút cho dễ bấm */
        }

            /* 2. Cố định chiều rộng của Icon để chữ bên phải luôn thẳng hàng dọc */
            .dropdown-item i {
                width: 25px; /* Tất cả icon đều chiếm 25px chiều rộng */
                text-align: center; /* Icon nằm giữa khoảng 25px đó */
                margin-right: 10px; /* Khoảng cách từ icon đến chữ */
            }

                /* (Tùy chọn) Xóa margin cũ của bootstrap để tránh bị cộng dồn khoảng cách */
                .dropdown-item i.me-2 {
                    margin-right: 10px !important;
                }
    </style>
</head>

<body>
    <!-- 🧭 NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")"><i class="fa-solid fa-cart-shopping me-2"></i>TechSecond</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link @(ViewBag.Title=="Trang chủ"?"active":"")" href="@Url.Action("Index","Home")">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","SanPham")">Sản phẩm</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("DanhSachShop","TaiKhoan")">Shop</a></li>

                    @if (user != null && user.VaiTro == "Admin")
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Admin")">Quản trị</a></li>
                    }
                </ul>

                <div class="d-flex align-items-center ms-auto">
                    <!-- TÌM KIẾM -->
                    <form class="d-flex align-items-center me-5" method="get" action="@Url.Action("Index","SanPham")">
                        <input class="form-control form-control-sm me-2" type="text" name="q" placeholder="Tìm kiếm sản phẩm..." style="border-radius:20px; min-width:550px;" />
                        <button class="btn btn-warning btn-sm px-3" type="submit"><i class="fa fa-search"></i></button>
                    </form>

                    <!-- GIỎ HÀNG -->
                    <div class="d-flex align-items-center ms-auto gap-3">
                        @Html.Action("CartIcon", "GioHang")    
 
                    </div>

                    <!-- NGƯỜI DÙNG -->
                    @if (user != null)
                    {
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle text-white d-flex align-items-center" href="#" data-bs-toggle="dropdown">
                                <img src="@anh"
                                     onerror="this.src='/Content/Avatars/default.jpg';"
                                     class="rounded-circle me-2 shadow-sm" width="28" height="28" />
                                @user.HoTen
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="@Url.Action("ThongTinKhachHang","TaiKhoan")"><i class="fa fa-user me-2"></i> Thông tin khách hàng</a></li>


                                <li><a class="dropdown-item" href="@Url.Action("TaoMoi","SanPham")"><i class="fa fa-plus-circle me-2"></i> Đăng bán</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("CuaToi","SanPham")"><i class="fa fa-box-open me-2"></i> Bài đăng</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("LichSu","TaiKhoan")"><i class="fa fa-history me-2"></i> Lịch sử</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("SanPhamDaBan","SanPham")"><i class="fa fa-solid fa-bell"></i> Thông báo</a></li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Chat", "TinNhan", new { idNguoiDung = user.MaKH, mode = "user" })">
                                        <i class="fa-regular fa-comments me-2"></i>
                                        Tin nhắn / Hỗ trợ
                                    </a>
                                </li>
                                <li><a class="dropdown-item" href="@Url.Action("DangXuat","TaiKhoan")"><i class="fa fa-sign-out me-2"></i> Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-warning btn-sm" href="@Url.Action("DangNhap","TaiKhoan")">Đăng nhập</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- 📦 BODY -->
    <main class="container-fluid p-0">
        @RenderBody()
    </main>

    <!-- 🦶 FOOTER -->
    <footer>
        <div class="container">
            <p>© 2025 - <b>TechSecond</b></p>
            <p><a href="#">Chính sách</a> | <a href="#">Điều khoản</a> | <a href="#">Liên hệ</a></p>
        </div>
    </footer>

    <!-- ✅ THÊM DÒNG NÀY Ở CUỐI -->
    @RenderSection("Scripts", required: false)
</body>
</html>
