@model IEnumerable<ThuongMaiDienTu_DoAn.Models.HOADON>
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container my-4">
    <h4 class="fw-bold text-primary mb-4"><i class="bi bi-receipt"></i> Quản lý đơn hàng</h4>

    <table class="table table-bordered table-hover text-center align-middle">
        <thead class="table-info">
            <tr>
                <th>Mã HD</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var hd in Model)
            {
                <tr>
                    <td>@hd.MaHD</td>
                    <td>@hd.NGUOIDUNG.HoTen</td>
                    <td>@(hd.NgayDat.HasValue ? hd.NgayDat.Value.ToString("dd/MM/yyyy") : "")</td>
                    <td class="text-danger fw-bold">@String.Format("{0:N0} ₫", hd.TongTien)</td>
                    <td>@hd.TrangThai</td>
                </tr>
            }
        </tbody>
    </table>
</div>
