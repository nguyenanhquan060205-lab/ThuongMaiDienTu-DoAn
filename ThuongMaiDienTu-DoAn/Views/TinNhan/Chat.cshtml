@model IEnumerable<ThuongMaiDienTu_DoAn.Models.NGUOIDUNG>

@{
    ViewBag.Title = "Tin nhắn";
    var currentUser = Session["user"] as ThuongMaiDienTu_DoAn.Models.NGUOIDUNG;

    // 1. Kiểm tra tín hiệu từ URL (được gửi từ _Layout.cshtml)
    string viewMode = Request.QueryString["mode"]; // Sẽ nhận giá trị "user" hoặc null

    // 2. Xác định quyền Admin
    bool isAdminAccount = (currentUser != null && currentUser.VaiTro == "Admin");

    // 3. QUYẾT ĐỊNH LAYOUT
    // Chỉ hiện Layout Admin khi: Tài khoản là Admin VÀ KHÔNG có yêu cầu xem mode user
    bool showAdminLayout = isAdminAccount && (viewMode != "user");

    if (showAdminLayout)
    {
        Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
        ViewBag.Title = "Dashboard quản trị";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<style>
    /* ====================== USER STYLE (MẶC ĐỊNH) ===================== */
    .chat-container {
        display: flex;
        width: 85%;
        margin: 40px auto;
        height: 72vh;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 4px 12px rgba(0,0,0,.1);
        overflow: hidden;
        position: relative;
    }

        /* ====================== ADMIN STYLE (GHI ĐÈ) ===================== */
        /* Class này chỉ được thêm vào khi showAdminLayout = true */
        .chat-container.admin-view {
            width: 100% !important;
            margin: 0 !important;
            height: 80vh !important;
            box-shadow: none !important;
            border: 1px solid #e0e0e0;
        }

    /* ====================== CÁC THÀNH PHẦN KHÁC ===================== */
    .user-list {
        width: 280px;
        background: #1d2033;
        color: #fff;
        border-right: 1px solid #2c2e43;
        overflow-y: auto;
    }

    .user-item {
        padding: 15px;
        border-bottom: 1px solid #2c2e43;
        cursor: pointer;
        transition: .2s;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .user-item:hover {
            background: #313553;
        }

        .user-item.active {
            background: #3d4163;
            border-left: 4px solid #0078ff;
        }

    .chat-box {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .chat-header {
        padding: 15px 20px;
        background: #fff;
        border-bottom: 1px solid #ddd;
        display: flex;
        align-items: center;
        font-size: 16px;
        font-weight: bold;
        color: #333;
    }
    /* Đổi màu header nhẹ khi ở Admin view */
    .admin-view .chat-header {
        background-color: #f8f9fa;
    }

    .chat-body {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        background: #f1f3f7;
        display: flex;
        flex-direction: column;
    }

    .msg {
        display: flex;
        margin-bottom: 15px;
        align-items: flex-end;
    }

        .msg img.avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
        }

    .bubble {
        padding: 10px 14px;
        max-width: 70%;
        margin: 0 8px;
        border-radius: 18px;
        line-height: 1.4;
        font-size: 14px;
        position: relative;
        word-wrap: break-word;
    }

    .msg.me {
        justify-content: flex-end;
    }

        .msg.me .bubble {
            background: #0078ff;
            color: white;
            border-bottom-right-radius: 4px;
        }

        .msg.me img.avatar {
            margin-left: 6px;
        }

    .msg.them {
        justify-content: flex-start;
    }

        .msg.them .bubble {
            background: #fff;
            color: #333;
            border-bottom-left-radius: 4px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .msg.them img.avatar {
            margin-right: 6px;
        }

    .bubble-time {
        font-size: 10px;
        margin-top: 4px;
        opacity: 0.7;
        text-align: right;
    }

    .chat-input {
        padding: 15px;
        background: #fff;
        border-top: 1px solid #ddd;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .chat-input input {
            flex: 1;
            border-radius: 20px;
            border: 1px solid #ccc;
            padding: 10px 15px;
            outline: none;
        }

        .chat-input button {
            border-radius: 50%;
            width: 40px;
            height: 40px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
</style>

@if (!showAdminLayout)
{
    <div style="width: 85%; margin: 0 auto;">
        <h2 class="fw-bold text-primary mb-3 mt-4">
            <i class="bi bi-receipt-cutoff"></i> Tin Nhắn
        </h2>
    </div>
}

<input type="hidden" id="NguoiGuiID" value="@ViewBag.NguoiGuiID" />
<input type="hidden" id="NguoiNhanID" value="@ViewBag.NguoiNhanID" />

<div class="chat-container @(showAdminLayout ? "admin-view" : "")">

    <div class="user-list">
        <div style="padding: 15px; border-bottom: 1px solid #3d4163;">
            <h5 class="m-0 text-white">Danh sách</h5>
        </div>
        @foreach (var u in Model)
        {
            <div class="user-item @(u.MaKH == ViewBag.NguoiNhanID ? "active" : "")"
                 onclick="location.href='@Url.Action("Chat", "TinNhan", new { idNguoiNhan = u.MaKH, mode = Request.QueryString["mode"] })'">

                <img src="~/Content/avatars/@(string.IsNullOrEmpty(u.AnhDaiDien) ? "Default.jpg" : u.AnhDaiDien)"
                     style="width:30px;height:30px;border-radius:50%;object-fit:cover;" />

                <div style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                    <b>@u.HoTen</b>
                </div>
            </div>
        }
    </div>

    <div class="chat-box">
        <div class="chat-header">
            <div>
                @if (ViewBag.NguoiNhanID != 0)
                {
                    <i class="fa-solid fa-circle-user me-2 text-primary"></i> <span>@ViewBag.NguoiNhanTen</span>
                }
                else
                {
                    <span>Chưa chọn người để trò chuyện</span>
                }
            </div>
        </div>

        <div id="messages" class="chat-body">
            @if (ViewBag.NguoiNhanID == 0)
            {
                <div class="text-center text-muted mt-5">
                    <i class="fa-regular fa-comments fa-3x mb-3"></i><br />
                    Vui lòng chọn một người dùng bên trái để bắt đầu
                </div>
            }
        </div>

        @if (ViewBag.NguoiNhanID != 0)
        {
            <div class="chat-input">
                <input id="txtMsg" type="text" placeholder="Nhập tin nhắn...">
                <button id="btnSend" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i></button>
            </div>
        }
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    let autoScroll = true;

    function loadTinNhan() {
        const idGui = $('#NguoiGuiID').val();
        const idNhan = $('#NguoiNhanID').val();
        if (idNhan == 0) return;

        $.getJSON('/TinNhan/LoadTinNhan',
            { idNguoiGui: idGui, idNguoiNhan: idNhan },
            function (data) {
                let html = "";
                let lastMyMsgIndex = -1;
                let lastMyMsgDaDoc = false;

                $.each(data, function (i, m) {
                    let isMe = m.NguoiGui == idGui;
                    if (isMe) { lastMyMsgIndex = i; lastMyMsgDaDoc = m.DaDoc; }
                    let avatarSrc = m.AvatarGui ? `/Content/avatars/${m.AvatarGui}` : '/Content/avatars/Default.jpg';

                    html += `
                    <div class="msg ${isMe ? 'me' : 'them'}">
                        ${!isMe ? `<img class="avatar" src="${avatarSrc}">` : ''}
                        <div class="bubble">
                            ${m.NoiDung}
                            <div class="bubble-time">${m.Gio}</div>
                        </div>
                        ${isMe ? `<img class="avatar" src="${avatarSrc}">` : ''}
                    </div>`;
                });

                $("#messages").html(html);

                if (lastMyMsgIndex >= 0 && lastMyMsgDaDoc) {
                    let msgDivs = $("#messages .msg.me");
                    let lastBubble = $(msgDivs[msgDivs.length - 1]).find('.bubble');
                    if (lastBubble.find('.seen-status').length === 0) {
                        lastBubble.append(`<div class="seen-status" style="font-size:10px;color:rgba(255,255,255,0.7);text-align:right;margin-top:2px;"><i class="fa-solid fa-check-double"></i> Đã xem</div>`);
                    }
                }

                if (autoScroll) {
                    const msgBox = $("#messages")[0];
                    msgBox.scrollTop = msgBox.scrollHeight;
                }
            });
    }

    $("#messages").on("scroll", function () {
        const el = $(this)[0];
        if (el.scrollTop + el.clientHeight < el.scrollHeight - 50) autoScroll = false;
        else autoScroll = true;
    });

    $("#btnSend").click(function () {
        const idGui = $('#NguoiGuiID').val();
        const idNhan = $('#NguoiNhanID').val();
        const msg = $("#txtMsg").val().trim();
        if (!msg) return;

        $.post('/TinNhan/GuiTinNhan', { nguoiGui: idGui, nguoiNhan: idNhan, noiDung: msg }, function () {
            $("#txtMsg").val(''); autoScroll = true; loadTinNhan();
        });
    });

    $('#txtMsg').keypress(function (e) {
        if (e.which === 13) { $("#btnSend").click(); return false; }
    });

    setInterval(loadTinNhan, 2000);
    loadTinNhan();
</script>