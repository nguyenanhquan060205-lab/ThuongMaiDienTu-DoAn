
@{
    ViewBag.Title = "Dashboard quản trị";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}



@model IEnumerable<ThuongMaiDienTu_DoAn.Models.DonHangC2CViewModel>

<div class="container-fluid px-4 mt-4">

    <h2 class="fw-bold text-primary mb-3">
        <i class="bi bi-receipt-cutoff"></i> Quản lý đơn hàng
    </h2>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h5 class="fw-bold text-dark mb-3">Danh sách đơn hàng</h5>

            <table class="table table-bordered text-center align-middle">
                <thead class="table-info">
                    <tr>
                        <th>Mã HD</th>
                        <th>Người mua</th>
                        <th>Người bán</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string badgeClass =
                                item.TrangThai == "Đang vận chuyển" ? "bg-info text-white" :
                                item.TrangThai == "Đã thanh toán" ? "bg-success text-white" :
                                item.TrangThai == "Đã Huỷ" ? "bg-danger text-white" :
                                "bg-warning text-dark"; // Đang chờ / mặc định

                            <tr>
                                <td>@item.MaHD</td>
                                <td>@item.NguoiMua</td>
                                <td>@item.NguoiBan</td>

                                <td>
                                    @(item.NgayDat.HasValue
                                        ? item.NgayDat.Value.ToString("dd/MM/yyyy")
                                        : "")
                                </td>

                                <td class="text-danger fw-bold">
                                    @String.Format("{0:N0} ₫", item.TongTien)
                                </td>

                                <td>
                                    <span class="badge @badgeClass px-3 py-2 fs-6">
                                        @item.TrangThai
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-muted py-4">
                                Không có đơn hàng nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
