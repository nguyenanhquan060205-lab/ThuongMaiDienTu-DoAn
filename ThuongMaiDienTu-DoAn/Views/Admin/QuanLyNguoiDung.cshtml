@model IEnumerable<ThuongMaiDienTu_DoAn.Models.NGUOIDUNG>
@{
    ViewBag.Title = "Quản lý người dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container my-4">
    <h4 class="fw-bold text-primary mb-4"><i class="bi bi-people-fill"></i> Quản lý người dùng</h4>

    <table class="table table-striped table-bordered align-middle text-center">
        <thead class="table-light">
            <tr>
                <th>Mã</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Ngày tạo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var nd in Model)
            {
                <tr>
                    <td>@nd.MaKH</td>
                    <td>@nd.HoTen</td>
                    <td>@nd.Email</td>
                    <td><span class="badge @(nd.VaiTro == "Admin" ? "bg-danger" : "bg-secondary")">@nd.VaiTro</span></td>
                    <td>@(nd.NgayTao.HasValue ? nd.NgayTao.Value.ToString("dd/MM/yyyy") : "")</td>

                </tr>
            }
        </tbody>
    </table>
</div>
