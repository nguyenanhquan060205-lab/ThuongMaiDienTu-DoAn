@model IEnumerable<ThuongMaiDienTu_DoAn.Models.NGUOIDUNG>
@{
    ViewBag.Title = "Dashboard quản trị";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4 mt-4">

    <h2 class="fw-bold text-primary mb-3">
        <i class="bi bi-people-fill"></i> Quản lý người dùng
    </h2>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h5 class="fw-bold text-dark mb-3">Danh sách người dùng</h5>

            <table class="table table-bordered text-center align-middle">
                <thead class="table-info">
                    <tr>
                        <th>Mã</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Ngày tạo</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var nd in Model)
                    {
                        string badgeClass =
                            nd.VaiTro == "Admin"
                            ? "bg-danger text-white"
                            : "bg-secondary text-white";

                        <tr>
                            <td>@nd.MaKH</td>
                            <td>@nd.HoTen</td>
                            <td>@nd.Email</td>

                            <td>
                                <span class="badge @badgeClass px-3 py-2 fs-6">
                                    @nd.VaiTro
                                </span>
                            </td>

                            <td>
                                @(nd.NgayTao.HasValue
                                    ? nd.NgayTao.Value.ToString("dd/MM/yyyy")
                                    : "")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
