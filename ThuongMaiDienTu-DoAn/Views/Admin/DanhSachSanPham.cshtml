@model IEnumerable<ThuongMaiDienTu_DoAn.Models.SANPHAM>
@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container my-4">
    <h4 class="fw-bold text-primary mb-4"><i class="bi bi-box-seam"></i> Danh sách sản phẩm</h4>

    <table class="table table-hover table-bordered text-center align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã</th>
                <th>Tên sản phẩm</th>
                <th>Người bán</th>
                <th>Giá</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sp in Model)
            {
                <tr>
                    <td>@sp.MaSP</td>
                    <td>@sp.TenSP</td>
                    <td>@sp.NGUOIDUNG.HoTen</td>
                    <td>@String.Format("{0:N0} ₫", sp.Gia)</td>
                    <td>
                        <span class="badge @(sp.TrangThai == "Đã duyệt" ? "bg-success" : "bg-warning text-dark")">@sp.TrangThai</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
