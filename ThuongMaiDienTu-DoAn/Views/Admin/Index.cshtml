@{
    ViewBag.Title = "Dashboard quản trị";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4">
    <h2 class="fw-bold text-primary mb-4">
        <i class="bi bi-bar-chart-fill"></i> Tổng quan hệ thống
    </h2>

    <div class="row text-center">

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 py-3">
                <div class="card-body">
                    <i class="bi bi-hourglass-split text-warning fs-1"></i>
                    <h4 class="fw-bold mt-2">@ViewBag.TinChoDuyet</h4>
                    <p class="text-muted">Tin chờ duyệt</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 py-3">
                <div class="card-body">
                    <i class="bi bi-check-circle-fill text-success fs-1"></i>
                    <h4 class="fw-bold mt-2">@ViewBag.TinDaDuyet</h4>
                    <p class="text-muted">Tin đã duyệt</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 py-3">
                <div class="card-body">
                    <i class="bi bi-person-badge text-info fs-1"></i>
                    <h4 class="fw-bold mt-2">@ViewBag.TongNguoiDung</h4>
                    <p class="text-muted">Người dùng</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 py-3">
                <div class="card-body">
                    <i class="bi bi-box-seam text-primary fs-1"></i>
                    <h4 class="fw-bold mt-2">@ViewBag.TongSanPham</h4>
                    <p class="text-muted">Tổng sản phẩm</p>
                </div>
            </div>
        </div>

    </div>

    <div class="text-center mt-4">
        <a href="@Url.Action("DuyetTin", "Admin")" class="btn btn-outline-primary px-4">
            <i class="bi bi-check2-square"></i> Duyệt tin đăng
        </a>
    </div>
</div>
