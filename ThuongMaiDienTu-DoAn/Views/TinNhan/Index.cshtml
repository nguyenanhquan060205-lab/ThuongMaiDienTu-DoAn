@model IEnumerable<ThuongMaiDienTu_DoAn.Models.NGUOIDUNG>
@{
    ViewBag.Title = "Tin nhắn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-3">
    <h4 class="text-primary fw-bold mb-3">💬 Đoạn chat</h4>

    <ul class="list-group">
        @foreach (var u in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                    <i class="fa-solid fa-user text-secondary me-2"></i>
                    <b>@u.HoTen</b>
                </span>
                <a href="@Url.Action("Chat", "TinNhan", new { idNguoiDung = u.MaKH })"
                   class="btn btn-sm btn-outline-primary">Chat</a>
            </li>
        }
    </ul>
</div>
